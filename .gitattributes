# 统一换行符，避免 Windows / Unix 协作时产生无意义的 diff
* text=auto eol=lf

# 明确指定二进制类型
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.woff binary
*.woff2 binary

# Markdown 与文本文件始终用 LF
*.md text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf

# 锁文件在 diff 中折叠
package-lock.json -diff linguist-generated=true
